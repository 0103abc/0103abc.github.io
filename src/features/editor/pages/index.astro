---
import { getCollection } from 'astro:content';
import BootScripts from '@layouts/BootScripts.astro';
import { colophonConfig, siteTimezone } from '@lib/config/site';
import { getPostSlug } from '@lib/content/locale';
import { buildEditorColophon } from '../colophon-dictionary';
import Editor from '../Editor';
import '@styles/index.css';
import '../editor.css';

const ogEndpoint = import.meta.env.PUBLIC_EDITOR_OG_ENDPOINT || '/api/editor/og';
// Serialized into the island props at build time; only the marks' own icons ship, not the icon sets.
const colophon = buildEditorColophon(colophonConfig);
const reservedLinks = (await getCollection('blog')).map(getPostSlug);
---
<!doctype html>
<html lang="zh">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <meta name="description" content="在浏览器中编辑 Markdown、实时预览，并通过自己的 GitHub 账号发布博客。" />
    <meta name="referrer" content="no-referrer" />
    <title>写作室 · 0103abc</title>
    <link rel="icon" href="/favicon.ico" />
    <BootScripts />
  </head>
  <body class="editor-page">
    <Editor client:load ogEndpoint={ogEndpoint} colophon={colophon} reservedLinks={reservedLinks} siteTimezone={siteTimezone} />
    <noscript>写作室需要 JavaScript 才能编辑和实时预览。</noscript>
  </body>
</html>
